#!/opt/lsfce/pyenv/bin/python3
#
# QRMI JOB_STARTER script
# 
# This script
# 
# 1. Publishes allocated quantum resources to the job environment
# 2. Launches the target application
# 3. Expects QRMI acquisition tokens to be written to environment
#    variables by the job or acquisition layer
# 4. Releases all acquired quantum resources during cleanup
# 
# Resource releases are performed on a best-effort basis to avoid
# resource leaks while ensuring that failure to release one resource
# does not prevent cleanup of others.
#
import sys
import os
import subprocess
import json
from qrmi import QuantumResource, ResourceType, ResourceProvider, ResourceStatusCode

RES_TYPE_MAP = {
    "ibm-quantum-system": ResourceType.IBMQuantumSystem,
    "ibm-quantum-compute-service": ResourceType.IBMQuantumComputeService,
    "qiskit-runtime-service": ResourceType.IBMQiskitRuntimeService,
    "pasqal-cloud": ResourceType.PasqalCloud,
    "pasqal-local": ResourceType.PasqalLocal,
    "alice-bob-felis": ResourceType.AliceBobFelis,
    "iqm-server": ResourceType.IQMServer,
    "oqtopus": ResourceType.OQTOPUS,
}

# Delimiter for list string
QRMI_LIST_DELIMITER = ","

acquired_resources = {}

# Print message to stderr
def print_debug(message):
    if debug:
        print(f"{os.path.basename(sys.argv[0])}: [DEBUG] {message}", file=sys.stderr)

# Print to stderr and exit
def print_error(message):
    print(f"{os.path.basename(sys.argv[0])}: [ERROR] {message}", file=sys.stderr)
    exit(1)

# Set environment variable for quantum job (then used by QRMI)
def set_env(name, value):
    print_debug(f"Setting {name} = {value}")
    os.environ[name] = value

# As of QRMI 0.25, a quantum resource can be built from an in-memory
# config map instead of environment varliables. This allows us to put
# publically available information in LSF_ENVDIR/qrmi_config.json and
# pass private information (API keys) through bsub
def build_config_map(name, cfg):
    config_map = {}
    print_debug("From qrmi_config.json...")
    for key, value in cfg["environment"].items():
        env_name = f"{name}_{key}"
        config_map[key] = value
        set_env(env_name, value)
    print_debug("From user environment...")
    for key, value in os.environ.items():
        if key.startswith("QRMI_"):
            config_map[key] = value
            env_name = f"{name}_{key}"
            set_env(env_name, value)
    return config_map

# Get bearer token and make it available to the job
def acquire_token(qrmi):
    name = qrmi.resource_id()
    token = qrmi.acquire()
    set_env(f"{name}_QRMI_JOB_ACQUISITION_TOKEN", token)

# main
# QRMI_QPU_RESOURCES indicates if we have a quantum job
resources = os.getenv("QRMI_QPU_RESOURCES")
job_args = sys.argv[1:]

try:
    if resources:
        debug = os.getenv("LSF_QRMI_DEBUG")
        cfg_path = os.path.join(os.getenv("LSF_ENVDIR"), "qrmi_config.json")
        with open(cfg_path, "r", encoding="utf8") as f:
            cfg_json = json.load(f)
            cfg_by_name = {r["name"]: r for r in cfg_json["resources"]}

            managed_resources = {}
            for name in resources.split(QRMI_LIST_DELIMITER):
                print_debug(f"Checking {name}")
                name = name.strip()
                if not (cfg := cfg_by_name.get(name)):
                    print_debug(f"{name} not found in qrmi_config.json. Ignored.")
                    continue

                try:
                    qrmi = QuantumResource.from_config(name, RES_TYPE_MAP[cfg["type"]], build_config_map(name, cfg))
                    print_debug(f"resource_type = {qrmi.resource_type()}, resource_id={qrmi.resource_id()}")
                    status = qrmi.status()
                    print_debug(f"status = {json.dumps(status.to_dict(), indent=2)}")
                    if status.status != ResourceStatusCode.Online:
                    # The quantum resource cannot accept jobs due
                    # to maintenance, calibration, or other operational
                    # activities. Put it back on the queue. Note that
                    # the 99 exit code must be defined in lsb.queues
                    # (REQUEUE_EXIT_VALUES)
                        print_debug(f"{name} is inaccessible. Trying next resource.")
                        continue
                    acquire_token(qrmi)
                    acquired_resources[name] = qrmi
                    managed_resources[qrmi.resource_id()] = cfg["type"]
                except RuntimeError as re:
                    print_error(f"Failed to process request in QRMI for {name}: {re}")

        if len(managed_resources) == 0:
            print(
                f"No specified quantum resources ({resources}) are available",
                file=sys.stderr,
            )
            raise SystemExit(99)

        # Expose allocated quantum resources to the QRMI job.
        #
        # QRMI_JOB_QPU_RESOURCES: Delimiter-separated list of logical
        # resource names allocated to this job. These names correspond
        # to the resource definitions in the scheduler configuration
        # and are used when constructing resource-specific environment
        # variables such as <RESOURCE_NAME>_QRMI_JOB_ACQUISITION_TOKEN.
        #
        # QRMI_JOB_QPU_TYPES: Delimiter-separated list of QPU types
        # corresponding to the resources listed in QRMI_JOB_QPU_RESOURCES.
        # The nth entry in QRMI_JOB_QPU_TYPES describes the nth resource
        # in QRMI_JOB_QPU_RESOURCES.
        #
        # QRMI_LIST_DELIMITER: Delimiter used to encode list-valued
        # QRMI environment variables. Consumers should use this value
        # rather than assuming a fixed separator character.
        set_env("QRMI_JOB_QPU_RESOURCES", QRMI_LIST_DELIMITER.join(managed_resources.keys()))
        set_env("QRMI_JOB_QPU_TYPES", QRMI_LIST_DELIMITER.join(managed_resources.values()))
        set_env("QRMI_LIST_DELIMITER", QRMI_LIST_DELIMITER)

    # Launch the user job. Quantum job is expected to acquire QRMI
    # resources and store acquisition tokens through environment
    # variables, eg, # <RESOURCE_NAME>_QRMI_JOB_ACQUISITION_TOKEN.
    # Tokens are required to release the resource when the job
    # completes.
    result = subprocess.run(job_args)
    return_code = result.returncode
finally:
    if resources:
	# Always attempt resource cleanup, regardless of job success,
	# failure, or exception in subprocess handling.
        #
	# Note that this cleanup executes only while the launcher
	# process remains alive. It cannot run after an external
	# SIGKILL.
        for name, qrmi in acquired_resources.items():
	    # Token generated during acquisition and propagated
	    # through the job environment.
            token = os.getenv(f"{name}_QRMI_JOB_ACQUISITION_TOKEN")
            if not token:
		# Missing token likely indicates that acquisition
		# never occurred, the environment variable was not
		# propagated, or the job modified/removed it.
                print(f"Missing token for {name}", file=sys.stderr)
                continue
            try:
                qrmi.release(token)
                print_debug(f"{name} released = {token}")
            except RuntimeError as re:
		# Release failures are logged and do not prevent
		# cleanup attempts for other resources
                print(f"{name} release failed: {re}", file=sys.stderr)
# Propagate application exit status to LSF.
# Python returns negative codes when subprocesses terminate by signal.
if return_code < 0:
    return_code = 128 - return_code
sys.exit(return_code)
